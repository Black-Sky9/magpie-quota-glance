{
  "name": "magpie-quota-glance",
  "version": "0.1.5",
  "description": "把每个供应商的积分使用详情和总览显示在底部板块，同时也标记了3天内过期的积分详情。",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "icon.svg",
    "panel/quota.html",
    "panel/quota.css",
    "panel/quota.js",
    "docs/screenshot.png",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "usage",
    "quota",
    "credits",
    "panel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Black-Sky9/magpie-quota-glance.git"
  },
  "homepage": "https://github.com/Black-Sky9/magpie-quota-glance#readme",
  "magpie": {
    "name": "积分总览",
    "icon": "data:image/svg+xml;base64,",
    "panels": [
      {
        "slot": "usage",
        "file": "panel/quota.html",
        "title": "Credits",
        "titles": {
          "zh": "积分总览",
          "zh-TW": "積分總覽",
          "ja": "クレジット概要"
        }
      },
      {
        "slot": "provider",
        "file": "panel/quota.html",
        "title": "Credits",
        "titles": {
          "zh": "积分总览",
          "zh-TW": "積分總覽",
          "ja": "クレジット概要"
        }
      }
    ]
  }
}
